generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* =======================
  ENUMS
======================= */

enum UserRole {
  mentee
  mentor
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  inactive
  pending_approval
  pending_review
  approved
  rejected
  banned
  suspended
  deleted

  @@map("user_status")
}

enum AccountActivationRequestStatus {
  pending
  approved
  rejected

  @@map("account_activation_request_status")
}

enum MenteePreferredSessionType {
  online
  in_person

  @@map("mentee_preferred_session_type")
}

enum LogsActionType {
  create
  read
  update
  delete
  signin
  signup
  signout
  resend_email_confirmation
  update_password
  forgot_password
  reset_password
  verify_reset_pin
  deactivate_account
  admin_activate_mentee
  admin_deactivate_mentee
  admin_reject_mentee
  admin_resend_verification
  admin_force_cancel_booking
  admin_approve_mentor
  admin_reject_mentor
  admin_deactivate_mentor
  admin_feature_mentor
  admin_unfeature_mentor
  passkey_register
  passkey_rename
  passkey_remove
  signin_passkey
  signin_google
  google_connect
  google_disconnect
  admin_add_notification_recipient
  admin_remove_notification_recipient
  admin_approve_mentor_reactivation
  admin_reject_mentor_reactivation
  account_auto_deleted
  admin_update_badge
  admin_award_badge

  @@map("logs_action_type")
}

enum BadgeCategory {
  MENTOR
  MENTEE
  SPECIAL

  @@map("badge_category")
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY

  @@map("badge_rarity")
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  DELETED

  @@map("booking_status")
}

enum NotificationType {
  BOOKING
  SESSION
  MESSAGE
  ANNOUNCEMENT

  @@map("notification_type")
}

enum NotificationStatus {
  UNREAD
  READ
  DELETED

  @@map("notification_status")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

/* =======================
  MODELS
======================= */

model User {
  id                         String     @id @default(uuid()) @map("id")
  firstName                  String     @map("first_name")
  middleName                 String?    @map("middle_name")
  lastName                   String     @map("last_name")
  suffix                     String?
  email                      String     @unique
  country                    String?
  timezone                   String?
  language                   String?
  phoneNumber                String?    @map("phone_number")
  hashPassword               String     @map("hash_password")
  isProfileComplete          Boolean    @default(false) @map("is_profile_complete")
  isMentorProfileComplete    Boolean    @default(false) @map("is_mentor_profile_complete")
  isMentorApproved           Boolean    @default(false) @map("is_mentor_approved")
  role                       UserRole
  status                     UserStatus
  createdById                String?    @map("created_by_id")
  updatedById                String?    @map("updated_by_id")
  deactivationToken          String?    @map("deactivation_token")
  deactivationTokenExpiresAt DateTime?  @map("deactivation_token_expires_at")
  /// When the user deactivated their own account (email link flow). Drives the
  /// 30-day automatic deletion; null for accounts an admin deactivated.
  deactivatedAt              DateTime?  @map("deactivated_at")
  pendingHashPassword        String?    @map("pending_hash_password")
  pendingPasswordChangeAt    DateTime?  @map("pending_password_change_at")
  /// Supabase identity_id of the Google account the user connected in Settings
  googleIdentityId           String?    @map("google_identity_id")
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  // Relations
  createdBy             User?                @relation("user_created_by", fields: [createdById], references: [id])
  updatedBy             User?                @relation("user_updated_by", fields: [updatedById], references: [id])
  createdUsers          User[]               @relation("user_created_by")
  updatedUsers          User[]               @relation("user_updated_by")
  menteeProfiles        MenteeProfile[]      @relation("mentee_base_user")
  mentorProfiles        MentorProfile[]      @relation("mentor_base_user")
  menteeProfilesUpdated MenteeProfile[]      @relation("mentee_updated_by")
  mentorProfilesUpdated MentorProfile[]      @relation("mentor_updated_by")
  avatarAttachments     AvatarAttachment[]
  documentAttachments   DocumentAttachment[]

  logsCreated           Logs[]                @relation("logs_created_by")
  logsUpdated           Logs[]                @relation("logs_updated_by")
  notifications         Notification[]
  bookingsAsMentee      Booking[]             @relation("MenteeBookings")
  bookingsAsMentor      Booking[]             @relation("MentorBookings")
  deactivationFeedback  DeactivationFeedback?
  activationRequest     AccountActivationRequest?
  bookingFeedback       BookingFeedback[]
  adminRejections       AdminRejectionLog[]   @relation("mentee_rejections")
  mentorRejections      AdminRejectionLog[]   @relation("mentor_rejections")
  adminRejectionActions AdminRejectionLog[]   @relation("admin_rejection_actions")
  passkeys              Passkey[]
  passkeyChallenges     PasskeyChallenge[]
  badges                UserBadge[]           @relation("user_badges")
  badgesAwarded         UserBadge[]           @relation("badge_awarded_by")

  @@map("users")
}

model MenteeProfile {
  id                   String                       @id @default(uuid())
  userId               String                       @unique @map("user_id")
  bio                  String?
  learningGoals        String[]                     @map("learning_goals")
  areasOfInterest      String[]                     @map("areas_of_interest")
  preferredSessionType MenteePreferredSessionType[] @map("preferred_session_type")
  updatedById          String?                      @map("updated_by_id")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  user      User  @relation("mentee_base_user", fields: [userId], references: [id])
  updatedBy User? @relation("mentee_updated_by", fields: [updatedById], references: [id])

  @@map("mentee_profiles")
}

model MentorProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  title                  String?
  areasOfExpertise       String[]  @map("areas_of_expertise")
  yearsOfExperience      Int?      @map("years_of_experience")
  linkedInUrl            String?   @map("linkedin_url")
  bio                    String?
  skills                 String[]
  sessionRate            Float?    @map("session_rate")
  sessionDurationMinutes Int       @default(60) @map("session_duration_minutes")
  availability           Json
  availabilityTimezone   String    @default("UTC") @map("availability_timezone")
  availabilityOverrides  Json      @default("[]") @map("availability_overrides")
  isFeatured             Boolean   @default(false) @map("is_featured")
  featuredAt             DateTime? @map("featured_at")
  updatedById            String?   @map("updated_by_id")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user      User  @relation("mentor_base_user", fields: [userId], references: [id])
  updatedBy User? @relation("mentor_updated_by", fields: [updatedById], references: [id])

  @@index([isFeatured])
  @@map("mentor_profiles")
}

model AvatarAttachment {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  bucketName  String @map("bucket_name")
  storagePath String @map("storage_path")
  publicUrl   String @map("public_url")
  fileType    String @map("file_type")
  fileSize    Int    @map("file_size")
  fileName    String @map("file_name")

  user User @relation(fields: [userId], references: [id])

  @@map("avatar_attachments")
}

model DocumentAttachment {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  bucketName  String @map("bucket_name")
  storagePath String @map("storage_path")
  publicUrl   String @map("public_url")
  fileType    String @map("file_type")
  fileSize    Int    @map("file_size")
  fileName    String @map("file_name")

  user User @relation(fields: [userId], references: [id])

  @@map("document_attachments")
}

model Logs {
  id          String         @id @default(uuid())
  actionType  LogsActionType @map("action_type")
  targetId    String         @map("target_id")
  details     String
  metadata    Json?
  ipAddress   String         @map("ip_address")
  userAgent   String         @map("user_agent")
  createdById String?        @map("created_by_id")
  updatedById String?        @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  createdBy User? @relation("logs_created_by", fields: [createdById], references: [id])
  updatedBy User? @relation("logs_updated_by", fields: [updatedById], references: [id])

  @@map("logs")
}

model Notification {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  title       String
  message     String
  type        NotificationType
  status      NotificationStatus @default(UNREAD)
  referenceId String?            @map("reference_id")
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Booking {
  id              String        @id @default(uuid())
  menteeId        String        @map("mentee_id")
  mentorId        String        @map("mentor_id")
  sessionDateTime DateTime      @map("session_date_time")
  status          BookingStatus @default(PENDING)
  sessionLink     String?       @map("session_link")
  menteeNotes     String?       @map("mentee_notes")
  mentorNotes     String?       @map("mentor_notes")
  cancelReason    String?       @map("cancel_reason")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  mentee          User              @relation("MenteeBookings", fields: [menteeId], references: [id])
  mentor          User              @relation("MentorBookings", fields: [mentorId], references: [id])
  feedback        BookingFeedback[]
  emailDeliveries EmailDelivery[]

  @@map("bookings")
}

model EmailDelivery {
  id                String              @id @default(uuid())
  eventKey          String              @unique @map("event_key")
  eventType         String              @map("event_type")
  bookingId         String?             @map("booking_id")
  recipientEmail    String              @map("recipient_email")
  status            EmailDeliveryStatus @default(PENDING)
  attemptCount      Int                 @default(0) @map("attempt_count")
  providerMessageId String?             @map("provider_message_id")
  lastError         String?             @map("last_error")
  attemptedAt       DateTime?           @map("attempted_at")
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("email_deliveries")
}

model BookingFeedback {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@map("booking_feedback")
}

model DeactivationFeedback {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("deactivation_feedback")
}

model AccountActivationRequest {
  id         String                         @id @default(uuid())
  userId     String                         @unique @map("user_id")
  reason     String
  status     AccountActivationRequestStatus @default(pending)
  createdAt  DateTime                       @default(now()) @map("created_at")
  reviewedAt DateTime?                      @map("reviewed_at")
  /// Admin who approved/rejected a mentor request (null for auto-approved mentees).
  reviewedById String?                      @map("reviewed_by_id")
  /// Reason shown to the mentor when an admin rejects the request.
  reviewNote String?                        @map("review_note")

  user User @relation(fields: [userId], references: [id])

  @@map("account_activation_requests")
}

model AdminRejectionLog {
  id        String   @id @default(uuid())
  menteeId  String?  @map("mentee_id")
  mentorId  String?  @map("mentor_id")
  adminId   String   @map("admin_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  mentee User? @relation("mentee_rejections", fields: [menteeId], references: [id])
  mentor User? @relation("mentor_rejections", fields: [mentorId], references: [id])
  admin  User  @relation("admin_rejection_actions", fields: [adminId], references: [id])

  @@map("admin_rejection_logs")
}

/// Contact form submissions from the public marketing site.
///
/// Intentionally has no relation to `User` — inquiries come from anonymous
/// visitors who may not have an account. Spam is handled by reCAPTCHA at the
/// endpoint, so no IP address or user agent is stored.
/// A WebAuthn passkey. Only the public key is stored; the private key never
/// leaves the user's device or password manager.
model Passkey {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  /// base64url credential ID, unique across all users
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  /// signature counter, used to spot cloned authenticators at login
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// "singleDevice" or "multiDevice" (synced, e.g. iCloud Keychain)
  deviceType   String    @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  /// authenticator model identifier, when the authenticator shares it
  aaguid       String?
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// One-time challenge for a passkey ceremony, valid for a few minutes.
model PasskeyChallenge {
  id        String               @id @default(uuid())
  /// null for login challenges, where the user isn't known yet
  userId    String?              @map("user_id")
  challenge String               @unique
  type      PasskeyChallengeType
  expiresAt DateTime             @map("expires_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("passkey_challenges")
}

enum PasskeyChallengeType {
  registration
  authentication

  @@map("passkey_challenge_type")
}

model Inquiry {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("inquiries")
}

/// Email addresses that receive admin alerts (e.g. a new mentor waiting for
/// approval). Managed from the Admin Portal, not tied to admin accounts so a
/// shared inbox can be added too.
model AdminNotificationRecipient {
  id          String   @id @default(uuid())
  email       String   @unique
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin_notification_recipients")
}

/// A badge definition. Seeded from BADGE_DEFINITIONS by `code`; admins can
/// change rarity, category, target and active status afterwards.
model Badge {
  id               String        @id @default(uuid())
  code             String        @unique
  name             String
  description      String
  category         BadgeCategory
  rarity           BadgeRarity
  /// What is counted (BadgeRequirementType); `manual` for special badges.
  requirementType  String        @map("requirement_type")
  requirementValue Int           @map("requirement_value")
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@map("badges")
}

/// A user's progress toward, or ownership of, one badge. Once unlocked it
/// stays unlocked, even if the activity behind it is later removed.
model UserBadge {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  badgeId     String    @map("badge_id")
  progress    Int       @default(0)
  target      Int
  unlocked    Boolean   @default(false)
  unlockedAt  DateTime? @map("unlocked_at")
  featured    Boolean   @default(false)
  /// Admin who awarded a special badge; null for automatic unlocks.
  awardedById String?   @map("awarded_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user      User  @relation("user_badges", fields: [userId], references: [id])
  badge     Badge @relation(fields: [badgeId], references: [id])
  awardedBy User? @relation("badge_awarded_by", fields: [awardedById], references: [id])

  @@unique([userId, badgeId])
  @@index([userId, featured])
  @@map("user_badges")
}
